# Copy only the desired settings into the repository's ignored .env.
# Keep credentials on the server. Never put them in browser JavaScript or git.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
BRAVE_API_KEY=
DATA_ROOT=data/meme-agent
# Optional local font file if the platform has no Chinese font installed:
# MEME_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc
