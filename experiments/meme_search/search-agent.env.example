# Add the desired values to the ignored local .env; never commit real keys.
SEARCH_AGENT_PROVIDER=auto
SEARCH_AGENT_MODE=web
SEARCH_AGENT_USE_MODEL=true
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
BRAVE_API_KEY=
TAVILY_API_KEY=
# Self-hosted instance with search.formats: [html, json]
SEARXNG_URL=http://127.0.0.1:8080
