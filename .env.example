APP_ENV=development
LOG_LEVEL=INFO
POSTGRES_PASSWORD=
WORKER_POLL_SECONDS=2.0
SEARCH_WORKER_STOP_GRACE_PERIOD=330s
WORKER_REQUEST_TIMEOUT_SECONDS=20.0
STARTER_WORKER_STOP_GRACE_PERIOD=30s
API_HOST_PORT=8000
AI_BIND_HOST=127.0.0.1
AI_HOST_PORT=8100
PROMETHEUS_BIND_HOST=127.0.0.1
POSTGRES_HOST_PORT=5432
API_BIND_HOST=127.0.0.1
REFERENCE_HOST_PATH=./data/reference
DEVICE_TOKEN=
# Optional Telegram GIF collection. Set only on the API service.
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
# Optional Discord server sticker export. Set only on the API service.
DISCORD_BOT_TOKEN=
DISCORD_STICKER_GUILD_ID=
DISCORD_STICKER_GUILD_NAME=
DISCORD_STICKER_ACCOUNTS=[]
# Optional on-demand Signal packs. Use a dedicated, linked signal-cli account.
SIGNAL_CLI_EXECUTABLE=
SIGNAL_CLI_DATA_DIR=
SIGNAL_STICKER_ACCOUNTS=[]
# Set to the HTTPS reverse proxy's address when terminating TLS before Uvicorn.
FORWARDED_ALLOW_IPS=127.0.0.1
MAX_UPLOAD_BYTES=10485760
MAX_CANDIDATE_BYTES=26214400
MEDIA_RETENTION_DAYS=7
RETRIEVAL_TIMEOUT_SECONDS=120
WEB_SEARCH_TIMEOUT_SECONDS=60
WEB_SEARCH_CALL_TIMEOUT_SECONDS=12
WEB_SEARCH_MAX_DOWNLOADS=6
SAVED_INDEX_TIMEOUT_SECONDS=300
SEARCH_AGENT_PROVIDER=deepseek
SEARCH_AGENT_MODE=web
SEARCH_AGENT_DOMAINS=[]
SEARCH_AGENT_USE_MODEL=true
DEEPSEEK_MODEL=deepseek-flash
RETRIEVAL_MIN_SIMILARITY=0.82
DEEPSEEK_API_KEY=
# DeepSeek Flash reads images, plans queries and reviews candidates with DEEPSEEK_API_KEY.
MEME50_PROVIDER_POLICY=deepseek-only-v1
MEME50_VISION_PROVIDER=deepseek
MEME50_DEEPSEEK_MODEL=deepseek-flash
MEME50_KEYWORD_PROVIDER=deepseek
MEME50_REVERSE_IMAGE_PROVIDER=disabled
MEME50_VERIFY_ENTITIES=true
MEME50_TARGET_COUNT=50
MEME50_TIMEOUT_SECONDS=180
MEME50_CALL_TIMEOUT_SECONDS=18
MEME50_FETCH_URL=http://127.0.0.1:8120
MEME50_DNS_MODE=system
MEME50_MAX_SEARCH_CALLS=16
MEME50_MAX_MODEL_CALLS=3
MEME50_MAX_QUERIES=6
MEME50_MAX_SOURCES=500
MEME50_MAX_PREVIEWS=250
MEME50_MAX_ORIGINALS=120
MEME50_MAX_PAGES=40
MEME50_MAX_BYTES=536870912
MEME50_MAX_REDIRECTS=120
MEME50_CONCURRENCY=6
MEME50_MINIMUM_SCORE=0.50
MEME50_MAX_DISK_BYTES=536870912

# The product pgvector Compose profile enables both flags. Unset them to use
# its defaults. Enable both explicitly for the native account-based launcher.
# ACCOUNT_LOGIN_ENABLED=true
# PRIVATE_LIBRARY_ENABLED=true
# VECTOR_BACKEND=pgvector
