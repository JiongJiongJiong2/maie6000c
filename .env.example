APP_ENV=development
LOG_LEVEL=INFO
POSTGRES_PASSWORD=
WORKER_POLL_SECONDS=2.0
SEARCH_WORKER_STOP_GRACE_PERIOD=330s
WORKER_REQUEST_TIMEOUT_SECONDS=20.0
STARTER_WORKER_STOP_GRACE_PERIOD=30s
API_HOST_PORT=8000
AI_BIND_HOST=127.0.0.1
AI_HOST_PORT=8100
PROMETHEUS_BIND_HOST=127.0.0.1
POSTGRES_HOST_PORT=5432
API_BIND_HOST=127.0.0.1
REFERENCE_HOST_PATH=./data/reference
DEVICE_TOKEN=
MAX_UPLOAD_BYTES=10485760
MAX_CANDIDATE_BYTES=26214400
MEDIA_RETENTION_DAYS=7
RETRIEVAL_TIMEOUT_SECONDS=120
WEB_SEARCH_TIMEOUT_SECONDS=60
WEB_SEARCH_CALL_TIMEOUT_SECONDS=12
WEB_SEARCH_MAX_DOWNLOADS=6
SAVED_INDEX_TIMEOUT_SECONDS=300
SEARCH_AGENT_PROVIDER=auto
SEARCH_AGENT_MODE=web
SEARCH_AGENT_DDGS_BACKEND=bing
SEARCH_AGENT_DOMAINS=[]
SEARCH_AGENT_USE_MODEL=true
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
RETRIEVAL_MIN_SIMILARITY=0.82
DEEPSEEK_API_KEY=
# Legacy optional adapters; meme50-v2 does not use these services.
BRAVE_API_KEY=
TAVILY_API_KEY=
SEARXNG_URL=
# Image-first search. Keys stay on the worker; never on the fetch service/browser.
# This profile uses only HKUST vision and DeepSeek Flash/Search.
MEME50_PROVIDER_POLICY=hkust-deepseek-v1
MEME50_VISION_PROVIDER=hkust
MEME50_HKUST_API_KEY=
MEME50_HKUST_MODEL=gemini-2.5-flash-lite
MEME50_DEEPSEEK_MODEL=deepseek-flash
MEME50_KEYWORD_PROVIDER=deepseek
MEME50_REVERSE_IMAGE_PROVIDER=disabled
MEME50_VERIFY_ENTITIES=true
MEME50_TARGET_COUNT=50
MEME50_TIMEOUT_SECONDS=180
MEME50_CALL_TIMEOUT_SECONDS=18
MEME50_FETCH_URL=http://127.0.0.1:8120
MEME50_DNS_MODE=system
MEME50_MAX_SEARCH_CALLS=16
MEME50_MAX_MODEL_CALLS=3
MEME50_MAX_QUERIES=6
MEME50_MAX_SOURCES=500
MEME50_MAX_PREVIEWS=250
MEME50_MAX_ORIGINALS=120
MEME50_MAX_PAGES=40
MEME50_MAX_BYTES=536870912
MEME50_MAX_REDIRECTS=120
MEME50_CONCURRENCY=6
MEME50_MINIMUM_SCORE=0.55
MEME50_MAX_DISK_BYTES=536870912
